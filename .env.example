# All optional. Defaults shown.
PORT=8080
HOST=0.0.0.0
# SQLite database + uploaded graphics packages
DATA_DIR=../../data
# Frame rate reported to graphics (renderCharacteristics) for new channels
FRAME_RATE=50
# once | always | never – import the example graphics in ./graphics on start
SEED_MODE=once
LOG_LEVEL=info
LOAD_TIMEOUT_MS=12000
ACTION_TIMEOUT_MS=7000
MAX_UPLOAD_MB=200
