{
  "name": "@ogp/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Data hub and control server: graphics packages, channels, renderer gateway, data hub, OGraf Server API",
  "scripts": {
    "dev": "cross-env SEED_MODE=always tsx watch --clear-screen=false --ignore ./data src/main.ts",
    "start": "node dist/main.js",
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@ogp/ograf-core": "workspace:*",
    "@ogp/protocol": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.6.0",
    "fflate": "^0.8.2",
    "@ogp/sports-model": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/ws": "^8.18.0",
    "cross-env": "^10.0.0",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.28.2",
    "ws": "^8.18.0"
  }
}
